---
import type { StarlightRouteData } from "@astrojs/starlight/route-data";
import MobileMenuFooter from "@astrojs/starlight/components/MobileMenuFooter.astro";
import SidebarPersister from "@astrojs/starlight/components/SidebarPersister.astro";
import DocsNav from "./DocsNav";

type Entry = StarlightRouteData["sidebar"][number];
type Link = Extract<Entry, { type: "link" }>;

const flatten = (entries: Entry[]): Link[] =>
  entries.flatMap((entry) => (entry.type === "group" ? flatten(entry.entries) : [entry]));

const links = flatten(Astro.locals.starlightRoute.sidebar);
const items = links.map((link) => ({ id: link.href, label: link.label }));
const value = links.find((link) => link.isCurrent)?.href ?? "";
---

<SidebarPersister>
  <DocsNav client:load items={items} value={value} />
</SidebarPersister>

<div class="md:sl-hidden">
  <MobileMenuFooter />
</div>
