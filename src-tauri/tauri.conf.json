{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "zwinger",
  "version": "0.1.0",
  "identifier": "com.driif.zwinger",
  "build": {
    "beforeDevCommand": "bash scripts/fetch-pi.sh && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bash scripts/fetch-pi.sh && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "zwinger",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self'",
        "img-src": "'self' data:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost data:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "resources/pi": "pi"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "14.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYyNjBFOUI4QTYyMzE4OTEKUldTUkdDT211T2xnWW91K05ua3hnRmFSak9ldzFMS0E0OG1sWS9HTm9USW9BTHhQWUQzRUpyMnQK",
      "endpoints": [
        "https://github.com/driif/zwinger/releases/latest/download/latest.json"
      ]
    }
  }
}
