// Cloudflare Workers Builds deploys the docs site (site/) from the repo root on each push to main.
{
  "name": "zwinger",
  "compatibility_date": "2026-10-01",
  "build": {
    "command": "pnpm --filter site build"
  },
  "assets": {
    "directory": "./site/dist",
    "not_found_handling": "404-page"
  }
}
